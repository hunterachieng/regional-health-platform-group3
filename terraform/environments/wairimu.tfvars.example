# Copy this to wairimu.tfvars (gitignored — never commit the real one) and
# fill in your own Aiven values from aiven.io -> your MySQL service -> Overview.

project_name   = "rh-wairimu"
db_name        = "capacity_lab"
secret_name    = "regional-health/wairimu/db"
instance_type  = "t3.small"

# LocalStack Hobby: DescribeImages fails for docker-tagged AMIs when this is false.
skip_root_block_device = true

# From CI's `docker tag` step: localstack-ec2/app:ami-<sha12>. Placeholder
# below is fine until modules/service and Minage's CI pipeline exist.
app_ami_id = "localstack-ec2/app:ami-000000000000"

# --- Aiven MySQL (aiven.io -> your service -> Overview page) ---------------
aiven_host     = "mysql-xxxx-wairimu.aivencloud.com"
aiven_port     = 12345
aiven_user     = "avnadmin"
aiven_password = "REPLACE_ME"

# Paste the whole downloaded ca.pem here, e.g.:
# aiven_ca_cert = <<-EOT
# -----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
# EOT
aiven_ca_cert = "REPLACE_ME"
